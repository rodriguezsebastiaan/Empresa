# Dominio público final usado por metadata, canonical, robots, sitemap y social cards.
NEXT_PUBLIC_SITE_URL=https://pendiente-dominio-konamysystems.invalid

# Formulario de contacto.
CONTACT_DESTINATION_EMAIL=pendiente-contacto@konamysystems.invalid

# Diagnóstico por correo.
DIAGNOSTIC_DESTINATION_EMAIL=pendiente-diagnostico@konamysystems.invalid

# SMTP compartido para contacto y diagnóstico por correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=pendiente-no-reply@konamysystems.invalid
SMTP_FROM_NAME=Konamy Systems
SMTP_SECURE=false

# Webhook administrativo opcional para diagnóstico en n8n.
N8N_DIAGNOSTIC_WEBHOOK_URL=
N8N_DIAGNOSTIC_WEBHOOK_SECRET=

# Google Calendar y Google Meet para disponibilidad y reservas reales.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
