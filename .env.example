# Final public domain used by metadata, canonical, robots, sitemap, and social cards.
NEXT_PUBLIC_SITE_URL=https://pendiente-dominio-konamysystems.invalid

# Local isolated PostgreSQL instance for development without a system-wide install.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/konamy
LOCAL_POSTGRES_PORT=54329
LOCAL_POSTGRES_DB=konamy
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=postgres

# Initial admin seed and secure session secret.
ADMIN_SEED_NAME=Administrador Konamy
ADMIN_SEED_EMAIL=admin@konamysystems.invalid
ADMIN_SEED_PASSWORD=CAMBIAR-ANTES-DE-USAR
AUTH_SECRET=CAMBIAR-CON-UN-SECRETO-LARGO-Y-ALEATORIO

# General administrative destination for transactional notifications.
ADMIN_NOTIFICATION_EMAIL=pendiente-admin@konamysystems.invalid

# Optional module-specific destinations.
# Priority: module-specific destination, then ADMIN_NOTIFICATION_EMAIL, then no admin email.
CONTACT_DESTINATION_EMAIL=

DIAGNOSTIC_DESTINATION_EMAIL=

BOOKING_DESTINATION_EMAIL=

# Shared SMTP settings for contact, diagnostic, and advisory email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pendiente-no-reply@konamysystems.invalid
SMTP_FROM_NAME=Konamy Systems
SMTP_SECURE=false

# Legacy alias kept temporarily for older local environments.
# Prefer SMTP_PASSWORD for new configuration.
SMTP_PASS=

# Optional diagnostic webhook for n8n.
N8N_DIAGNOSTIC_WEBHOOK_URL=
N8N_DIAGNOSTIC_WEBHOOK_SECRET=

# Google Calendar and Google Meet for real availability and bookings.
# Use a Google Cloud service account shared with the target calendar.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Bogota
GOOGLE_CALENDAR_MODE=mock
GOOGLE_CALENDAR_MOCK_MODE=none
GOOGLE_IMPERSONATED_USER=contacto@konamysystems.com

# Resend integration for advisory booking notifications.
RESEND_API_KEY=
EMAIL_FROM=Konamy Systems <notificaciones@konamysystems.com>
EMAIL_REPLY_TO=contacto@konamysystems.com

# Public placeholders for floating social buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=PENDIENTE-NUMERO-WHATSAPP
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/PENDIENTE_USUARIO
